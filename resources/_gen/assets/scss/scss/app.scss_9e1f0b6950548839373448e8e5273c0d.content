  font-size: 1.5rem; }

[icy-dark-mode] .blog-single .related-resources {
  border-top: 1px solid #dee2e6; }

[icy-dark-mode] body .language-item a:hover {
  color: #dee2e6; }

[icy-dark-mode] .blog-content a {
  box-shadow: 0 0;
